{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "database",
      "image": "postgres:15",
      "essential": true,
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "${POSTGRES_USER}"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        },
        {
          "name": "POSTGRES_DB",
          "value": "${POSTGRES_DB}"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "postgres-data",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "portMappings": [
        {
          "hostPort": 5432,
          "containerPort": 5432
        }
      ]
    },
    {
      "name": "backend",
      "image": "your_backend_image",
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}"
        }
      ],
      "portMappings": [
        {
          "hostPort": 5000,
          "containerPort": 5000
        }
      ],
      "dependsOn": [
        {
          "containerName": "database",
          "condition": "START"
        }
      ]
    },
    {
      "name": "frontend",
      "image": "your_frontend_image",
      "essential": true,
      "portMappings": [
        {
          "hostPort": 3000,
          "containerPort": 3000
        }
      ],
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "START"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "postgres-data",
      "host": {
        "sourcePath": "/var/lib/postgresql/data"
      }
    }
  ]
}
